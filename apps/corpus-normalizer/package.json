{
  "name": "@red-cup-engineering/corpus-normalizer",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic, destination-dispatched corpus normalization transactions.",
  "bin": {
    "corpus-normalizer": "./scripts/corpus-normalizer.mjs",
    "term-markdown-migration": "./scripts/term-markdown-migration.mjs",
    "term-description-bridge": "./scripts/term-description-bridge.mjs",
    "note-keywords": "./scripts/note-keywords.mjs",
    "match-note-sections": "./scripts/match-note-sections.mjs",
    "move-sorted-notes": "./scripts/move-sorted-notes.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "plan": "node ./scripts/corpus-normalizer.mjs plan",
    "analyze-similarity": "node ./scripts/corpus-normalizer.mjs analyze-similarity",
    "inspect-archive": "node ./scripts/corpus-normalizer.mjs inspect-archive",
    "compare-trees": "node ./scripts/corpus-normalizer.mjs compare-trees",
    "assess-legacy": "node ./scripts/corpus-normalizer.mjs assess-legacy",
    "route": "node ./scripts/corpus-normalizer.mjs route",
    "note-keywords": "node ./scripts/note-keywords.mjs",
    "match-note-sections": "node ./scripts/match-note-sections.mjs",
    "move-sorted-notes": "node ./scripts/move-sorted-notes.mjs",
    "prepare-task": "node ./scripts/corpus-normalizer.mjs prepare-task",
    "receipt-task": "node ./scripts/corpus-normalizer.mjs receipt-task",
    "retire-archive": "node ./scripts/corpus-normalizer.mjs retire-archive",
    "complete-route": "node ./scripts/corpus-normalizer.mjs complete-route",
    "term-markdown-migration": "node ./scripts/term-markdown-migration.mjs",
    "term-description-bridge": "node ./scripts/term-description-bridge.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@red-cup-engineering/term-engineering-services-section": "workspace:*",
    "@red-cup-engineering/markdown-engineering-services-section": "workspace:*"
  }
}
