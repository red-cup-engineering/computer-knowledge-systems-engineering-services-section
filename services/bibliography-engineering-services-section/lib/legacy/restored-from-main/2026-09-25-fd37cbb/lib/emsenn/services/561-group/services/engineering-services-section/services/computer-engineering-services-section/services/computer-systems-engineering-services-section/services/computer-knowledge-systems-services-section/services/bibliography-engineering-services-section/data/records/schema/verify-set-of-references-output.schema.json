{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:verify-set-of-references-output:1",
  "title": "ReferenceVerificationSet",
  "type": "object",
  "required": ["type", "version", "rowCount", "defects", "defectCount", "agreed"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "ReferenceVerificationSet" },
    "version": { "const": 1 },
    "rowCount": { "type": "integer", "minimum": 0, "description": "Total rows verified, agreed and no-doi rows included." },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["citekey", "title", "year", "status"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "citekey": { "type": "string" },
          "doi": { "type": "string" },
          "title": { "type": "string" },
          "year": { "type": "integer" },
          "status": { "enum": ["title-mismatch", "year-mismatch", "unresolved"] },
          "resolvedTitle": { "type": "string", "description": "CrossRef's title for this doi; present for title-mismatch and year-mismatch." },
          "resolvedYear": { "type": ["integer", "null"], "description": "CrossRef's issued year for this doi; present for title-mismatch and year-mismatch." },
          "reason": { "type": "string", "description": "Why the doi could not be resolved; present for unresolved." }
        }
      }
    },
    "defectCount": { "type": "integer", "minimum": 0 },
    "agreed": { "type": "integer", "minimum": 0, "description": "Rows whose doi resolved and whose title and year matched CrossRef." }
  }
}
