{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bibliography/reference-entry",
  "title": "Depth-1 reference entry",
  "description": "One entry of a carrier's frontmatter `references:` map, keyed by citekey. Mirrors the glossary term reference contract (term-engineering-services-section's term.schema.json `references.additionalProperties`) exactly, so a carrier's inline citation and a bibliography carrier's own fields validate under the same law.",
  "type": "object",
  "required": [
    "authors",
    "title",
    "year"
  ],
  "additionalProperties": false,
  "properties": {
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Author names, at least one."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Title of the cited work."
    },
    "year": {
      "type": "integer",
      "minimum": 1,
      "description": "Publication year."
    },
    "publication": {
      "type": "string",
      "minLength": 1,
      "description": "Journal, conference, or other publication venue."
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "description": "Publisher of the cited work."
    },
    "translator": {
      "type": "string",
      "minLength": 1,
      "description": "Translator of the cited work, when applicable."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Locator for the cited work."
    },
    "doi": {
      "type": "string",
      "minLength": 1,
      "description": "Digital object identifier."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "description": "Free-text note about the reference."
    },
    "eprint": {
      "type": "string",
      "minLength": 1,
      "description": "Preprint identifier, e.g. an arXiv id."
    }
  }
}
